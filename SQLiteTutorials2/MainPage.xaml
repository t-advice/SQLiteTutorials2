<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SQLiteTutorials2.MainPage">

    <VerticalStackLayout Padding="20">
        <Entry x:Name="TaskEntry" Placeholder="Add a new task..." />
        <Button Text="Add Task" Clicked="OnAddTaskClicked" />

        <CollectionView x:Name="TasksList">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <StackLayout Orientation="Horizontal" Padding="5">
                        <CheckBox IsChecked="{Binding IsCompleted}" CheckedChanged="OnTaskCheckedChanged" />
                        <Label Text="{Binding Title}" VerticalOptions="Center" />
                        <Button Text="🗑️" Clicked="OnDeleteTaskClicked" CommandParameter="{Binding .}" />
                    </StackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>



</ContentPage>
